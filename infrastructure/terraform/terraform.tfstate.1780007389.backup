            "kind": "Deployment",
            "live_manifest_incluster": "c885b74ff0696aee6f842ee74c8f9bb889e1c9983583c65f0f0d495157553c20",
            "live_uid": "4446bf95-f525-4c27-aede-ad2ca3da0fcc",
            "name": "argocd-applicationset-controller",
            "namespace": "argocd",
            "override_namespace": "argocd",
            "sensitive_fields": null,
            "server_side_apply": false,
