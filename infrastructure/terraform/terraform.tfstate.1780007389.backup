            "live_manifest_incluster": "416f32abde37c8085483d2d1a287973af25276470c70d704ed5e99dd005d04ca",
            "live_uid": "6fae5dc2-3b3b-4070-a015-b719c1d96183",
            "name": "argocd-server",
